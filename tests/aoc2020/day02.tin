day 2020.2

# Each line is a password policy and a password, like "1-3 a: abcde".
# Part 1: valid passwords have between 1 and 3 a's.
# Part 2: valid passwords have an a at exactly one of positions 1 and 3
#         (counting from 1).

example """
1-3 a: abcde
1-3 b: cdefg
2-9 c: ccccccccc
"""
  part1 = 2
  part2 = 1

answers
  part1 = 620
  part2 = 727

policies = [(lo, hi, c, pw) for "{lo:int}-{hi:int} {c:char}: {pw}" in input.lines]

part1 = policies.count((lo, hi, c, pw) => lo <= pw.count(c) <= hi)
part2 = policies.count((lo, hi, c, pw) => (pw[lo - 1] == c) != (pw[hi - 1] == c))
