# Each line is an expression of numbers, +, * and parentheses.
# Part 1: + and * have equal precedence and work left to right. The sum
#         of the lines' values.
# Part 2: + comes before *.

example """
1 + (2 * 3) + (4 * (5 + 6))
"""
  part1 = 51
  part2 = 51

example """
2 * 3 + (4 * 5)
"""
  part1 = 26
  part2 = 46

example """
5 + (8 * 3 + 9 + 3 * 4 * 3)
"""
  part1 = 437
  part2 = 1445

example """
