answers
  part1 = 24650385570008
  part2 = 158183007916215

tokens(line) = line.replace("(", "( ").replace(")", " )").words

# Precedence climbing: each function gives (value, index of the next
# token). climb reads an expression whose operators all bind at least as
# tightly as `least`.
@nomemo
climb(prec, ts, i, least) = more(prec, ts, atom(prec, ts, i), least)

@nomemo
more(prec, ts, (lhs, j), least) =
  if j < ts.len and ts[j] in prec and prec[ts[j]] >= least
  then more(prec, ts, combine(ts[j], lhs, climb(prec, ts, j + 1, prec[ts[j]] + 1)), least)
  else (lhs, j)

combine("+", a, (b, k)) = (a + b, k)
combine("*", a, (b, k)) = (a * b, k)

@nomemo
atom(prec, ts, i) = if ts[i] == "(" then close(climb(prec, ts, i + 1, 0)) else (int(ts[i]), i + 1)
close((v, j)) = (v, j + 1)

evaluate(prec, line) = climb(prec, tokens(line), 0, 0).0

part1 = input.lines.map(evaluate({"+": 1, "*": 1}, _)).sum
part2 = input.lines.map(evaluate({"+": 2, "*": 1}, _)).sum
