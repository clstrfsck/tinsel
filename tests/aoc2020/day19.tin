day 2020.19

# Numbered grammar rules, each matching one character or a choice of
# sequences of other rules, and a list of messages.
# Part 1: how many messages match rule 0 completely.
# Part 2: rules 8 and 11 become "42 | 42 8" and "42 31 | 42 11 31", so
#         they loop. How many messages match now?

example """
0: 4 1 5
1: 2 3 | 3 2
2: 4 4 | 5 5
3: 4 5 | 5 4
4: "a"
5: "b"

ababbb
bababa
abbbab
aaabbb
aaaabbb
"""
  part1 = 2

example """
42: 9 14 | 10 1
9: 14 27 | 1 26
10: 23 14 | 28 1
1: "a"
11: 42 31
5: 1 14 | 15 1
19: 14 1 | 14 14
12: 24 14 | 19 1
16: 15 1 | 14 14
31: 14 17 | 1 13
6: 14 14 | 1 14
2: 1 24 | 14 4
0: 8 11
13: 14 3 | 1 12
15: 1 | 14
17: 14 2 | 1 7
23: 25 1 | 22 14
28: 16 1
4: 1 1
20: 14 14 | 1 15
3: 5 14 | 16 1
27: 1 6 | 14 18
14: "b"
21: 14 1 | 1 14
25: 1 1 | 1 14
22: 14 14
8: 42
26: 14 22 | 1 20
18: 15 15
7: 14 5 | 1 21
24: 14 1

abbbbbabbbaaaababbaabbbbabababbbabbbbbbabaaaa
bbabbbbaabaabba
babbbbaabbbbbabbbbbbaabaaabaaa
aaabbbbbbaaaabaababaabababbabaaabbababababaaa
bbbbbbbaaaabbbbaaabbabaaa
bbbababbbbaaaaaaaabbababaaababaabab
ababaaaaaabaaab
ababaaaaabbbaba
baabbaaaabbaaaababbaababb
abbbbabbbbaaaababbbbbbaaaababb
aaaaabbaabaaaaababaa
aaaabbaaaabbaaa
aaaabbaabbaaaaaaabbbabbbaaabbaabaaa
babaaabbbaaabaababbaabababaaab
aabbbbbaabbbaaaaaabbbbbababaaaaabbaaabba
"""
  part1 = 3
  part2 = 12

answers
  part1 = 165
  part2 = 274

[rule_text, message_text] = input.blocks

body("\"{c:char}\"") = c
body(alts) = alts.split(" | ").map(.ints)

rules = {id: body(b) for "{id:int}: {b}" in rule_text.lines}
messages = message_text.lines

# Every position in s where a match of rule r starting at i could end. The
# looping rules always consume characters before looping, so this ends.
@nomemo
ends(rs, r, s, i) = match rs[r]
  c: char => if i < s.len and s[i] == c then [i + 1] else []
  alts => [e for alt in alts for e in sequence(rs, alt, s, i)]

@nomemo
sequence(_, [], _, i) = [i]
sequence(rs, [r, ..rest], s, i) = [e for m in ends(rs, r, s, i) for e in sequence(rs, rest, s, m)]

matches(rs) = messages.count(m => m.len in ends(rs, 0, m, 0))

part1 = matches(rules)
part2 = matches(rules.set(8, [[42], [42, 8]]).set(11, [[42, 31], [42, 11, 31]]))
