day 2020.3

# A map of open squares (.) and trees (#) that repeats to the right.
# Part 1: going right 3 and down 1 from the top left, how many trees you
#         hit before passing the bottom.
# Part 2: the product of the trees hit on slopes (1, 1), (3, 1), (5, 1),
#         (7, 1) and (1, 2).

example """
..##.......
#...#...#..
.#....#..#.
..#.#...#.#
.#...##..#.
..#.##.....
.#.#.#....#
.#........#
#.##...#...
#...##....#
.#..#...#.#
"""
  part1 = 7
  part2 = 336

answers
  part1 = 242
  part2 = 2265549792

rows = input.lines

trees((right, down)) = [r for (i, r) in rows.enumerate if i % down == 0]
  .enumerate.count((k, r) => r[k * right % r.len] == '#')

part1 = trees((3, 1))
part2 = [(1, 1), (3, 1), (5, 1), (7, 1), (1, 2)].map(trees).product
