  part1 = 220
  part2 = 19208

answers
  part1 = 2232
  part2 = 173625106649344

adapters = input.ints.sort
chain = [0] ++ adapters ++ [adapters.max + 3]

gaps = chain.pairs.map((a, b) => b - a).counts

part1 = gaps.get(1, 0) * gaps.get(3, 0)

present = set(chain)

# Ways to get from rating j to the device.
ways(j) = if j == chain.last then 1 else [j + 1, j + 2, j + 3].filter(_ in present).map(ways).sum

part2 = ways(0)
