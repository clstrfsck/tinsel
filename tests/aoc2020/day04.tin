day 2020.4

# Passports, as blank-line separated groups of key:value fields.
# Part 1: how many have all of byr, iyr, eyr, hgt, hcl, ecl and pid (cid
#         is optional).
# Part 2: how many also have valid values in those fields.

example """
ecl:gry pid:860033327 eyr:2020 hcl:#fffffd
byr:1937 iyr:2017 cid:147 hgt:183cm

iyr:2013 ecl:amb cid:350 eyr:2023 pid:028048884
hcl:#cfa07d byr:1929

hcl:#ae17e1 iyr:2013
eyr:2024
ecl:brn pid:760753108 byr:1931
hgt:179cm

hcl:#cfa07d eyr:2025 pid:166559648
iyr:2011 ecl:brn hgt:59in
"""
  part1 = 2

example """
eyr:1972 cid:100
hcl:#18171d ecl:amb hgt:170 pid:186cm iyr:2018 byr:1926

iyr:2019
hcl:#602927 eyr:1967 hgt:170cm
ecl:grn pid:012533040 byr:1946

hcl:dab227 iyr:2012
ecl:brn hgt:182cm pid:021572410 eyr:2020 byr:1992 cid:277

hgt:59cm ecl:zzz
eyr:2038 hcl:74454a iyr:2023
pid:3556412378 byr:2007
"""
  part2 = 0

example """
pid:087499704 hgt:74in ecl:grn iyr:2012 eyr:2030 byr:1980
hcl:#623a2f

eyr:2029 ecl:blu cid:129 byr:1989
iyr:2014 pid:896056539 hcl:#a97842 hgt:165cm

hcl:#888785
hgt:164cm byr:2001 iyr:2015 cid:88
pid:545766238 ecl:hzl
eyr:2022

iyr:2010 hgt:158cm hcl:#b6652a ecl:blu byr:1944 eyr:2021 pid:093154719
"""
  part2 = 4

answers
  part1 = 210
  part2 = 131

passports = input.blocks.map(b => {k: v for "{k}:{v}" in b.words})

required = ["byr", "iyr", "eyr", "hgt", "hcl", "ecl", "pid"]

complete(p) = required.all(_ in p)

year(s, lo, hi) = s.len == 4 and s.is_digit and lo <= int(s) <= hi

valid("byr", v) = year(v, 1920, 2002)
valid("iyr", v) = year(v, 2010, 2020)
valid("eyr", v) = year(v, 2020, 2030)
valid("hgt", "{n:int}cm") = 150 <= n <= 193
valid("hgt", "{n:int}in") = 59 <= n <= 76
valid("hcl", v) = v.len == 7 and v[0] == '#' and v[1..].chars.all(c => c in "0123456789abcdef")
valid("ecl", v) = v in ["amb", "blu", "brn", "gry", "grn", "hzl", "oth"]
valid("pid", v) = v.len == 9 and v.is_digit
valid(_, _) = false

part1 = passports.count(complete)
part2 = passports.count(p => complete(p) and required.all(k => valid(k, p[k])))

test "byr" = valid("byr", "2002") and not valid("byr", "2003")
test "hgt" = valid("hgt", "60in") and valid("hgt", "190cm") and not valid("hgt", "190in") and not valid("hgt", "190")
test "hcl" = valid("hcl", "#123abc") and not valid("hcl", "#123abz") and not valid("hcl", "123abc")
test "ecl" = valid("ecl", "brn") and not valid("ecl", "wat")
test "pid" = valid("pid", "000000001") and not valid("pid", "0123456789")
