# Rules for which bags must contain which other bags, and how many.
# Part 1: how many colours of bag can eventually contain a shiny gold bag.
# Part 2: how many bags a shiny gold bag must contain.

example """
light red bags contain 1 bright white bag, 2 muted yellow bags.
dark orange bags contain 3 bright white bags, 4 muted yellow bags.
bright white bags contain 1 shiny gold bag.
muted yellow bags contain 2 shiny gold bags, 9 faded blue bags.
shiny gold bags contain 1 dark olive bag, 2 vibrant plum bags.
dark olive bags contain 3 faded blue bags, 4 dotted black bags.
vibrant plum bags contain 5 faded blue bags, 6 dotted black bags.
faded blue bags contain no other bags.
dotted black bags contain no other bags.
"""
  part1 = 4
  part2 = 32

example """
shiny gold bags contain 2 dark red bags.
dark red bags contain 2 dark orange bags.
dark orange bags contain 2 dark yellow bags.
dark yellow bags contain 2 dark green bags.
dark green bags contain 2 dark blue bags.
dark blue bags contain 2 dark violet bags.
dark violet bags contain no other bags.
"""
  part2 = 126

answers
  part1 = 197
  part2 = 85324

contents("no other bags.") = []
contents(text) = [(colour, n) for "{n:int} {colour} bag{_}" in text.split(", ")]

rules = {outer: contents(inner) for "{outer} bags contain {inner}" in input.lines}

holds_gold(c) = rules[c].any(((d, _)) => d == "shiny gold" or holds_gold(d))
inside(c) = rules[c].map((d, n) => n * (1 + inside(d))).sum

part1 = rules.keys.count(holds_gold)
part2 = inside("shiny gold")
