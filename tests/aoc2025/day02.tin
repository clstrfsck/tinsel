day 2025.2

# Product ID ranges. An ID is invalid when its digits are one block
# repeated: part 1 exactly twice (6464), part 2 at least twice (646464).
# Sum the invalid IDs.
#
# Instead of testing every ID in a range, generate the repeated-block
# numbers directly. An n-digit number made of a k-digit block is
# block * rep, where rep is 1 followed by copies of "0...01" (101 for
# k = 2, n = 4; 10101 for k = 2, n = 6).
# Reference: reference/2025/d02.py

example "11-22,95-115,998-1012,1188511880-1188511890,222220-222224,1698522-1698528,446443-446449,38593856-38593862,565653-565659,824824821-824824827,2121212118-2121212124"
  part1 = 1227775554
  part2 = 4174379265

answers
  part1 = 24747430309
  part2 = 30962646823

ranges = input.trim.split(",").map("{lo:int}-{hi:int}" => (lo, hi))

digits(n) = str(n).len
ceil_div(a, b) = -(-a / b)

# The n-digit numbers in lo..hi made of a k-digit block repeated n / k times.
repeated(lo, hi, n, k) = {block * rep for block in first..last}
  where
    rep = (10 ** n - 1) / (10 ** k - 1)
    first = max(10 ** (k - 1), ceil_div(max(lo, 10 ** (n - 1)), rep))
    last = min(10 ** k - 1, min(hi, 10 ** n - 1) / rep)

# Invalid IDs in a range, where `allowed(r)` says whether r repeats count.
# A set, because 222222 is 2 x 6, 22 x 3 and 222 x 2.
invalid((lo, hi), allowed) =
  {x for n in digits(lo)..digits(hi)
     for k in 1..n / 2 if n % k == 0 and allowed(n / k)
     for x in repeated(lo, hi, n, k)}

part1 = sum(invalid(r, _ == 2).sum for r in ranges)
part2 = sum(invalid(r, _ >= 2).sum for r in ranges)
