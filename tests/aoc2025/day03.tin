day 2025.3

# Each line is a bank of batteries, one digit each. Turn on exactly k of
# them, keeping their order, to make the largest k-digit number, and sum
# over the banks. Part 1: k = 2. Part 2: k = 12.
# Reference: reference/2025/d03.py

example """
987654321111111
811111111111119
234234234234278
818181911112111
"""
  part1 = 357
  part2 = 3121910778619

answers
  part1 = 17408
  part2 = 172740584266849

banks = input.lines.map(.chars.map(int))

# Greedy: take the largest digit that still leaves enough digits after it
# (the earliest one if there is a tie), then repeat on what follows it.
joltage(_, 0, acc) = acc
joltage(bank, k, acc) = joltage(bank[i + 1..], k - 1, acc * 10 + d)
  where
    d = bank[..<bank.len - k + 1].max
    i = bank.index(d)

part1 = banks.map(.joltage(2, 0)).sum
part2 = banks.map(.joltage(12, 0)).sum
