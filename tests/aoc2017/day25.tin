day 2017.25

# A Turing machine blueprint: for each state and the value under the
# cursor, the value to write, which way to move and the next state.
# Part 1: the number of 1s on the tape after the given number of steps.

example """
Begin in state A.
Perform a diagnostic checksum after 6 steps.

In state A:
  If the current value is 0:
    - Write the value 1.
    - Move one slot to the right.
    - Continue with state B.
  If the current value is 1:
    - Write the value 0.
    - Move one slot to the left.
    - Continue with state B.

In state B:
  If the current value is 0:
    - Write the value 1.
    - Move one slot to the left.
    - Continue with state A.
  If the current value is 1:
    - Write the value 1.
    - Move one slot to the right.
    - Continue with state A.
"""
  part1 = 3

answers
  part1 = 633

[header, ..blueprints] = input.blocks

begin_and_steps("""
Begin in state {state:char}.
Perform a diagnostic checksum after {n:int} steps.""") = (state, n)

(begin, steps) = begin_and_steps(header)

# For each value under the cursor: (state, value) => (value to write,
# move, next state).
rule("""
In state {state:char}:
  If the current value is 0:
    - Write the value {w0:int}.
    - Move one slot to the {m0}.
    - Continue with state {n0:char}.
  If the current value is 1:
    - Write the value {w1:int}.
    - Move one slot to the {m1}.
    - Continue with state {n1:char}.""") = [((state, 0), (w0, direction(m0), n0)), ((state, 1), (w1, direction(m1), n1))]

direction("left") = -1
direction("right") = 1

rules = {key: action for b in blueprints for (key, action) in rule(b)}

# The tape is the set of positions holding a 1.
run(0, _, _, ones) = ones.len
run(n, pos, state, ones) = run(n - 1, pos + move, next, if write == 1 then ones.add(pos) else ones.remove(pos))
  where
    (write, move, next) = rules[(state, int(pos in ones))]

part1 = run(steps, 0, begin, set())
