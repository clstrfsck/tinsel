day 2017.4

# Passphrases: lines of words.
# Part 1: how many have no repeated word.
# Part 2: how many have no two words that are anagrams of each other.

example """
aa bb cc dd ee
aa bb cc dd aa
aa bb cc dd aaa
"""
  part1 = 2

example """
abcde fghij
abcde xyz ecdab
a ab abc abd abf abj
iiii oiii ooii oooi oooo
oiii ioii iioi iiio
"""
  part2 = 3

answers
  part1 = 466
  part2 = 251

phrases = input.lines.map(.words)

distinct(ws) = ws.uniq.len == ws.len

part1 = phrases.count(distinct)
part2 = phrases.count(ws => distinct(ws.map(.sort)))
