day 2017.14

# A 128x128 disk: row i is the bits of the knot hash of "key-i".
# Part 1: how many squares are used (1 bits).

include "knot.tin"

example "flqrgnkx"
  part1 = 8108

answers
  part1 = 8074

key = input.trim

# A hash as a string of 128 binary digits.
bits(hash) = hash.chars.map(c => str(int(c, 16), 2, 4)).join

rows = [bits(knot_hash("{key}-{i}")) for i in 0..<128]

part1 = rows.map(.count('1')).sum
