day 2017.18

# Assembly: snd, set, add, mul, mod, rcv, jgz, with single-letter
# registers and number arguments.
# Part 1: the last sound played when the first rcv with a non-zero
#         argument runs.
# Part 2: two copies run at once, with p set to 0 and 1: snd sends a value
#         to the other copy and rcv waits for one. How many values copy 1
#         sends before both are waiting (or finished).

example """
set a 1
add a 2
mul a a
mod a 5
snd a
set a 0
rcv a
jgz a -1
set a 1
jgz a -2
"""
  part1 = 4

example """
snd 1
snd 2
snd p
rcv a
rcv b
rcv c
rcv d
"""
  part2 = 3

answers
  part1 = 8600
  part2 = 7239

program = input.lines.map(.words)

value(regs, "{n:int}") = n
value(regs, r) = regs.get(r, 0)

# The instructions that work the same in both parts, on a state
# (pc, registers).
exec((pc, regs), ["set", x, y]) = (pc + 1, regs.set(x, value(regs, y)))
exec((pc, regs), ["add", x, y]) = (pc + 1, regs.set(x, value(regs, x) + value(regs, y)))
exec((pc, regs), ["mul", x, y]) = (pc + 1, regs.set(x, value(regs, x) * value(regs, y)))
exec((pc, regs), ["mod", x, y]) = (pc + 1, regs.set(x, value(regs, x) % value(regs, y)))
exec((pc, regs), ["jgz", x, y]) = (pc + (if value(regs, x) > 0 then value(regs, y) else 1), regs)

recover((pc, regs), sound) = match program[pc]
  ["snd", x] => recover((pc + 1, regs), value(regs, x))
  ["rcv", x] => if value(regs, x) != 0 then sound else recover((pc + 1, regs), sound)
  ins => recover(exec((pc, regs), ins), sound)

part1 = recover((0, {}), none)

# Runs one copy until it waits for a value with none left in `inbox`
# (read from index i), or finishes: its state then, and what it sent.
run((pc, regs), inbox, i, sent) =
  if pc not in program.indices then ((pc, regs), sent)
  else match program[pc]
    ["snd", x] => run((pc + 1, regs), inbox, i, sent ++ [value(regs, x)])
    ["rcv", x] =>
      if i < inbox.len then run((pc + 1, regs.set(x, inbox[i])), inbox, i + 1, sent)
      else ((pc, regs), sent)
    ins => run(exec((pc, regs), ins), inbox, i, sent)

# Copy 0 runs on what copy 1 sent last time, then copy 1 on what copy 0
# just sent. When copy 1 sends nothing, copy 0 has nothing to go on: both
# are stuck.
duet(s0, s1, inbox, total) = if out1 == [] then total else duet(t0, t1, out1, total + out1.len)
  where
    (t0, out0) = run(s0, inbox, 0, [])
    (t1, out1) = run(s1, out0, 0, [])

part2 = duet((0, {"p": 0}), (0, {"p": 1}), [], 0)
