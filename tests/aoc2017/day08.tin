day 2017.8

# Register instructions: `b inc 5 if a > 1`. Registers start at 0.
# Part 1: the largest value in any register at the end.
# Part 2: the largest value any register held at any point.

example """
b inc 5 if a > 1
a inc 1 if b < 5
c dec -10 if a >= 1
c inc -20 if c == 10
"""
  part1 = 1
  part2 = 10

answers
  part1 = 5946
  part2 = 6026

compare(a, "<", b) = a < b
compare(a, "<=", b) = a <= b
compare(a, ">", b) = a > b
compare(a, ">=", b) = a >= b
compare(a, "==", b) = a == b
compare(a, "!=", b) = a != b

change("inc", n) = n
change("dec", n) = -n

execute(regs, "{r} {op} {n:int} if {c} {cmp} {m:int}") =
  if compare(regs.get(c, 0), cmp, m) then regs.set(r, regs.get(r, 0) + change(op, n))
  else regs

states = input.lines.scan({}, execute)

part1 = states.last.values.max
# Registers start at 0, so before any is set the largest value is 0.
part2 = states.map(m => m.values.max ?? 0).max
