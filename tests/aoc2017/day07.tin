day 2017.7

# A tower of programs: each line names a program, its weight, and the
# programs standing on its disc.
# Part 1: the name of the program at the bottom.

example """
pbga (66)
xhth (57)
ebii (61)
havc (66)
ktlj (57)
fwft (72) -> ktlj, cntj, xhth
qoyq (66)
padx (45) -> pbga, havc, qoyq
tknk (41) -> ugml, padx, fwft
jptl (61)
ugml (68) -> gyxo, ebii, jptl
gyxo (61)
cntj (57)
"""
  part1 = "tknk"

answers
  part1 = "mwzaxaj"

parse("{name} ({weight:int}) -> {above}") = (name, weight, above.split(", "))
parse("{name} ({weight:int})") = (name, weight, [])

programs = input.lines.map(parse)

# The bottom program is the only one not standing on another.
part1 = (set(programs.map(.0)) - set(programs.map(.2).flatten)).first
