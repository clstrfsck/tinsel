day 2017.6

# Memory banks: each cycle empties the fullest bank (the first, on a tie)
# and deals its blocks out one at a time to the banks after it, wrapping.
# Part 1: the number of cycles until a configuration repeats.

example "0 2 7 0"
  part1 = 5

answers
  part1 = 11137

banks = tuple(input.ints)

# The fullest bank's n blocks: every bank gets n / L of them, and the
# n % L banks after it one more.
redistribute(b) = tuple(
  (if k == i then 0 else b[k]) + n / L + int((k - i - 1) % L < n % L)
  for k in 0..<L)
  where
    L = b.len
    i = b.index(b.max)
    n = b[i]

(start, period, _) = iterate(banks, redistribute).find_cycle

part1 = start + period
