day 2017.17

# A spinlock: starting from [0], step forward `steps` places around the
# buffer, insert the next number after that place, and continue from it.
# Part 1: the number after 2017 once 2017 has been inserted.
# Part 2: the number after 0 once 50 million has been inserted.

example "3"
  part1 = 638

answers
  part1 = 1561
  part2 = 33454823

steps = int(input.trim)

# The buffer and the position of the number just inserted.
spin((buf, pos), n) = (buf[..at] ++ [n] ++ buf[at + 1..], at + 1)
  where
    at = (pos + steps) % buf.len

(buffer, last) = (1..2017).fold(([0], 0), spin)

part1 = buffer[(last + 1) % buffer.len]

# 0 never moves from the front, so only what is inserted just after it
# matters, and the buffer itself isn't needed: just its length (n, before
# inserting n) and the position.
after_zero(n, pos, after) =
  if n > 50_000_000 then after
  else after_zero(n + 1, at + 1, if at == 0 then n else after)
  where
    at = (pos + steps) % n

part2 = after_zero(1, 0, none)
