# Tuples as vectors. SPEC section 5.3.

test "tuple + tuple"              = (1, 2) + (10, 20) == (11, 22)
test "tuple - tuple"              = (5, 5, 5) - (1, 2, 3) == (4, 3, 2)
test "scalar broadcast"           = ((1, 2) * 3, 3 * (1, 2)) == ((3, 6), (3, 6))
test "element-wise floor division and modulo" = ((7, -7) / 2, (7, -7) % 2) == ((3, -4), (1, 1))
test "parity vector"              = (3, 4, 5) % 2 == (1, 0, 1)
test "sum of vectors"             = [(1, 2), (3, 4)].sum == (4, 6)
test_error "length mismatch"      = (1, 2) + (1, 2, 3)
test "unary minus"                = -(1, -2) == (-1, 2)
test "nested tuples"              = ((1, 2), 3) + ((10, 20), 30) == ((11, 22), 33)

test "element-wise comparison"    = (1, 5) .<= (2, 5) == (true, true)
test "all of element-wise"        = not all((1, 5) .<= (2, 4))
test "element-wise against scalar" = all((0, 0, 0) .== 0)
test "scalar on the left of an element-wise comparison" = (0 .< (1, -1)) == (true, false)
test "ordinary comparison is lexicographic" = (1, 9) < (2, 0)

test "tuple from generator"       = tuple(x * 2 for x in 1..3) == (2, 4, 6)
test "tuple index"                = (7, 8, 9).2 == 9
test "one-element tuple"          = (5,).len == 1
test "tuples as map keys"         = {(0, 0): "origin"}[(0, 0)] == "origin"

# Pairs of small ints are stored packed into one word (an implementation
# detail): they must behave exactly like any other 2-tuple, including at
# the edge of the packed range (ints of 28 bits) and when mixed with
# tuples that can't be packed.
edge = 2 ** 27 - 1
test "pairs at the packing edge" = (edge, -edge - 1).0 == edge and (edge, -edge - 1).1 == -edge - 1
test "pairs leaving the packed range" = (edge, 0) + (1, 0) == (edge + 1, 0) and ((edge + 1, 0) - (1, 0)).0 == edge
test "packed and unpacked pairs order together" = sort([(1, 2 ** 70), (1, 2), (-3, 4), (edge + 1, 0), (1, -2)]) == [(-3, 4), (1, -2), (1, 2), (1, 2 ** 70), (edge + 1, 0)]
test "packed and unpacked pairs as keys" = {(1, 2): 'a', (1, 2 ** 70): 'b', (2 ** 40, 0): 'c'}[(1, 2 ** 70)] == 'b' and {(1, 2), (1, 2), (2 ** 40, 0)}.len == 2
test "pairs of other things stay tuples" = (1, "a").1 == "a" and (none, 2).0 == none and ('x', 'y') != (1, 2)
times((a, b)) = a * b
test "pair patterns" = times((3, -4)) == -12 and [(2, 3), (edge, 1)].map(((x, y)) => x - y) == [-1, edge - 1]
kind_of(_: tuple) = "tuple"
kind_of(_) = "other"
test "a pair is a 2-tuple" = kind_of((7, 8)) == "tuple" and (7, 8).len == 2 and [(1, 2)] == [(1, 2)] and (1, 2) in {(1, 2)}
