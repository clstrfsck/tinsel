# Rangesets: sets of ints stored as merged ranges. SPEC section 9.8.

test "merging"                    = rangeset([1..3, 2..5, 7]) == rangeset([1..5, 7])
test "touching ranges merge"      = rangeset([1..2, 3..4, 6..<8]).ranges == [1..4, 6..7]
test "empty ranges are ignored"   = (rangeset([5..1]), rangeset([]).ranges) == (rangeset(), [])
test_error "infinite ranges are an error" = rangeset([1..])
test_error "only ranges and ints" = rangeset(["a"])

a = rangeset([1..10, 20..30])
b = rangeset([5..25])
test "union"                      = (a | b).ranges == [1..30]
test "intersection"               = (a & b).ranges == [5..10, 20..25]
test "difference"                 = ((a - b).ranges, (b - a).ranges) == ([1..4, 26..30], [11..19])
test_error "a rangeset and a set don't mix" = a | {1}

test "len counts ints"            = (a.len, rangeset().len, rangeset([1..10 ** 12]).len) == (21, 0, 10 ** 12)
test "membership"                 = 10 in a and 15 not in a and 30 in a and "x" not in a
test "min, max, first, last"      = (a.min, a.max, a.first, a.last, rangeset().min) == (1, 30, 1, 30, none)
test "iterating gives the ints"   = list(rangeset([1..3, 7])) == [1, 2, 3, 7]
test "lazy over a huge rangeset"  = rangeset([10..10 ** 15]).first(_ % 7 == 0) == 14
test "displayed"                  = str(rangeset([1..5, 7])) == "rangeset([1..5, 7..7])"
test "as set elements"            = {rangeset([1]), rangeset([1..1]), rangeset([2])}.len == 2
test "type pattern"               = [rangeset(), 1..2].map(x => match x
    _: rangeset => "rangeset"
    _ => "other") == ["rangeset", "other"]
test_error "rangesets aren't ordered" = rangeset([1]) < rangeset([2])

# 2025 day 5 part 2: how many IDs the ranges cover.
test "counting covered IDs"       = rangeset([3..5, 10..14, 16..20, 12..18]).len == 14

# Property check: on many pseudo-random rangesets, the operations agree with
# ordinary sets of the same ints.
lcg(x) = (x * 1103515245 + 12345) % 2147483648
nth(seed, i) = iterate(seed, lcg, times: i)
spans(seed) = [nth(seed, 2 * i) % 40..nth(seed, 2 * i) % 40 + nth(seed, 2 * i + 1) % 6 for i in 1..4]
cases = [(rangeset(spans(s)), rangeset(spans(s + 1000))) for s in 1..60]
agrees((a, b)) =
  set(a | b) == set(a) | set(b) and
  set(a & b) == set(a) & set(b) and
  set(a - b) == set(a) - set(b) and
  (a | b).len == (set(a) | set(b)).len and
  all((x in a) == (x in set(a)) for x in -2..50)
test "rangeset operations agree with sets" = cases.all(agrees)
test "the cases aren't trivial" = cases.count(((a, b)) => (a & b).len > 0 and (a - b).len > 0) > 20
