# `where` constants are computed on first use, at most once per call
# (SPEC 7.2). The IR engines compute many of them as plain locals rather
# than through a record (src/ir/wheres.rs); these check that nothing about
# that can be seen.

# A chain, each constant using the one before.
chain(x) = (a, b, c)
  where
    a = x + 1
    b = a * 2
    c = b + a

test "a chain of constants" = chain(1) == (2, 4, 6)

# Used only in one branch: not computed on the other, where it would fail.
safe(x) = if x > 0 then inverse else 0
  where
    inverse = 100 / x

test "a constant used in one branch only" = (safe(4), safe(0)) == (25, 0)

# Never used: never computed.
unused(x) = x
  where
    bad = [][x]

test "an unused constant isn't computed" = unused(3) == 3

# First used in different branches, then again after them.
branches(x) = (if x > 0 then k else k + 1) + k
  where
    k = x * 10

test "uses in both branches and after" = (branches(1), branches(-1)) == (20, -19)

# Used in a loop: the same value every pass.
looped(xs) = [x + base for x in xs]
  where
    base = xs.len * 100

test "a constant used in a comprehension" = looped([1, 2]) == [201, 202]

# Captured by a lambda, which may run after the call.
adder(n) = x => x + step
  where
    step = n * 2

test "a constant captured by a lambda" = adder(3)(1) == 7

# Used by a where function.
scaled(xs) = xs.map(scale)
  where
    factor = 3
    scale(x) = x * factor

test "a constant used by a where function" = scaled([1, 2]) == [3, 6]

# A pattern constant.
parts(s) = a + b
  where
    [a, b] = s.ints

test "a pattern constant" = parts("3 4") == 7

# Errors still happen, from whichever constant is reached first.
fails(x) = a + b
  where
    a = [][x]
    b = 1

test_error "a failing constant" = fails(0)
test_error "a constant that fails to match its pattern" = parts("1 2 3")

# Constants that depend on each other in a cycle are still an error.
cycle(x) = a
  where
    a = b + x
    b = a

test_error "a cycle of constants" = cycle(1)

# In a tail-recursive loop, each call has its own constants.
count_down(0, acc) = acc
count_down(n, acc) = count_down(n - 1, acc + double)
  where
    double = n * 2

test "fresh constants on each call of a loop" = count_down(1000, 0) == 1001000
