  part1 = 79
  part2 = 3621

answers
  part1 = 390
  part2 = 13327

scanners = input.blocks.map(b => b.lines[1..].map(.ints.tuple))

# The 24 rotations: permutations of the axes with signs, keeping
# handedness (an odd permutation needs an odd number of minus signs).
parity(p) = [1 for i in 0..<3 for j in i + 1..<3 if p[i] > p[j]].len % 2
rotations = [(p, s) for p in (0..<3).perms for s in [(a, b, c) for a in [1, -1] for b in [1, -1] for c in [1, -1]]
             if (if parity(p) == 0 then 1 else -1) * s.product == 1]

turn(v, (p, s)) = (s.0 * v[p.0], s.1 * v[p.1], s.2 * v[p.2])

# Squared distances between pairs of beacons don't depend on where a
# scanner is or how it is turned. Overlapping scanners share at least
# 12 * 11 / 2 of them.
fingerprint(bs) = {(a - b).map(_ * _).sum for (a, b) in bs.combos(2)}
prints = scanners.map(fingerprint)
close(i, j) = (prints[i] & prints[j]).len >= 66

# Turn and move scanner bs to match beacons already placed: gives (its
# beacons in scanner 0's coordinates, its position), or none.
align(known, bs) = [fit for r in rotations
                        let turned = bs.map(turn(_, r))
                        let (offset, n) = [a - b for a in known for b in turned].counts.items.max_by(.1)
                        if n >= 12
                        let fit = (turned.map(_ + offset), offset)].first

# Place scanners breadth first, each next to one already placed.
explore([], placed) = placed
explore([i, ..rest], placed) = explore(rest ++ found.keys, placed | found)
  where
    found = {j: fit for j in scanners.indices
                    if j not in placed and close(i, j)
                    let fit = align(placed[i].0, scanners[j])
                    if fit != none}

placed = explore([0], {0: (scanners[0], (0, 0, 0))})

part1 = set(placed.values.map(.0).flatten).len
part2 = placed.values.map(.1).combos(2).map(manhattan).max
