day 2021.21

# Two players on a circular track of spaces 1 to 10. On a turn a player
# rolls three times, moves that far, and scores the space landed on.
# Part 1: with a die that rolls 1, 2, ..., 100, 1, ..., the first to 1000
#         wins. The loser's score times the number of rolls.
# Part 2: with a three-sided Dirac die, each roll splits the universe in
#         three, and the first to 21 wins. In how many universes does the
#         player who wins in more universes win?

example """
Player 1 starting position: 4
Player 2 starting position: 8
"""
  part1 = 739785
  part2 = 444356092776315

answers
  part1 = 504972
  part2 = 446968027750017

[_, p1, _, p2] = input.ints

land(pos, roll) = (pos + roll - 1) % 10 + 1

# The player to move is first. rolled counts the die rolls so far.
practice(pos, score, other, other_score, rolled) =
  if other_score >= 1000 then score * rolled
  else practice(other, other_score, moved, score + moved, rolled + 3)
  where
    moved = land(pos, 3 * (rolled % 100) + 6)

part1 = practice(p1, 0, p2, 0, 0)

# The ways three rolls of 1-3 make each total.
totals = [a + b + c for a in 1..3 for b in 1..3 for c in 1..3].counts

# (wins for the player to move, wins for the other), memoized.
wins(pos, score, other, other_score) =
  totals.items.map((roll, ways) => turn(land(pos, roll), score, other, other_score) * ways).sum

turn(moved, score, other, other_score) =
  if score + moved >= 21 then (1, 0)
  else match wins(other, other_score, moved, score + moved)
    (theirs, mine) => (mine, theirs)

part2 = wins(p1, 0, p2, 0).max
