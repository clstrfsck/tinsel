day 2021.11

# A grid of octopus energy levels. Each step, every level goes up by 1;
# then any octopus above 9 flashes (once per step), raising its eight
# neighbours by 1, which may make them flash too. Those that flashed go to
# 0.
# Part 1: the number of flashes in 100 steps.
# Part 2: the first step in which every octopus flashes.

example """
5483143223
2745854711
5264556173
6141336146
6357385478
4167524645
2176841721
6882881134
4846848554
5283751526
"""
  part1 = 1656
  part2 = 195

answers
  part1 = 1585
  part2 = 382

octopuses = input.grid(int)
start = {p: octopuses[p] for p in octopuses.positions}

# Flash every octopus above 9 that hasn't flashed yet, until none is left.
cascade(levels, flashed) =
  if ready == [] then (levels, flashed)
  else cascade(bumps.fold(levels, (m, (p, n)) => m.set(p, m[p] + n)), flashed | set(ready))
  where
    ready = [p for (p, e) in levels.items if e > 9 and p not in flashed]
    bumps = [q for p in ready for q in octopuses.nbrs8(p)].counts.items

# One step: (new levels, how many flashed).
step(levels) = (settled.keys.fold(settled, (m, p) => if p in flashed then m.set(p, 0) else m), flashed.len)
  where
    (settled, flashed) = cascade({p: e + 1 for (p, e) in levels.items}, set())

# States are (step number, levels, flashes in that step).
next_state((i, levels, _)) = match step(levels)
  (after, n) => (i + 1, after, n)

# A generator can be read only once, so each part makes its own.
states(levels) = iterate((0, levels, 0), next_state)

part1 = states(start).take(101).map(.2).sum
part2 = states(start).first(_.2 == start.len).0
