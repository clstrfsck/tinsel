day 2021.18

# Snailfish numbers are pairs of numbers or pairs. Adding two makes a pair
# of them, then reduces it: repeatedly explode the first pair nested inside
# four pairs (its numbers are added to the nearest regular numbers to the
# left and right, and it becomes 0), or else split the first number of 10
# or more into a pair (half rounded down, half rounded up).
# Part 1: the magnitude of the sum of the list (3 * left + 2 * right).
# Part 2: the largest magnitude of the sum of any two different numbers.

example """
[[[0,[5,8]],[[1,7],[9,6]]],[[4,[1,2]],[[1,4],2]]]
[[[5,[2,8]],4],[5,[[9,9],0]]]
[6,[[[6,2],[5,6]],[[7,6],[4,7]]]]
[[[6,[0,7]],[0,9]],[4,[9,[9,0]]]]
[[[7,[6,4]],[3,[1,3]]],[[[5,5],1],9]]
[[6,[[7,3],[3,2]]],[[[3,8],[5,7]],4]]
[[[[5,4],[7,7]],8],[[8,3],8]]
[[9,3],[[9,9],[6,[4,9]]]]
[[2,[[7,7],7]],[[5,8],[[9,3],[0,2]]]]
[[[[5,2],5],[8,[3,7]]],[[5,[7,5]],[4,4]]]
"""
  part1 = 4140
  part2 = 3993

answers
  part1 = 3665
  part2 = 4775

# A number is a flat list of (value, depth) for its regular numbers, from
# left to right. A pair is two neighbours at the same depth, with nothing
# deeper between them.
parse(s) = s.chars.fold(([], 0), read).0
read((out, d), c) = match c
  '[' => (out, d + 1)
  ']' => (out, d - 1)
  ',' => (out, d)
  _ => (out ++ [(int(c), d)], d)

add(a, b) = reduce((a ++ b).map((v, d) => (v, d + 1)))

reduce(xs) = match xs.index(_.1 > 4)
  none => match xs.index(_.0 >= 10)
    none => xs
    i => reduce(split(xs, i))
  i => reduce(explode(xs, i))

explode(xs, i) = left ++ [(0, d - 1)] ++ right
  where
    ((a, d), (b, _)) = (xs[i], xs[i + 1])
    left = [if j == i - 1 then (v + a, e) else (v, e) for (j, (v, e)) in xs[..<i].enumerate]
    right = [if j == 0 then (v + b, e) else (v, e) for (j, (v, e)) in xs[i + 2..].enumerate]

split(xs, i) = xs[..<i] ++ [(v / 2, d + 1), ((v + 1) / 2, d + 1)] ++ xs[i + 1..]
  where
    (v, d) = xs[i]

# Collapse the deepest pairs first, leftmost first.
magnitude([(v, _)]) = v
magnitude(xs) = magnitude(xs[..<i] ++ [(3 * xs[i].0 + 2 * xs[i + 1].0, deepest - 1)] ++ xs[i + 2..])
  where
    deepest = xs.map(.1).max
    i = xs.index(_.1 == deepest)

numbers = input.lines.map(parse)

part1 = magnitude(numbers[1..].fold(numbers[0], add))
part2 = [magnitude(add(a, b)) for (i, a) in numbers.enumerate for (j, b) in numbers.enumerate if i != j].max
