day 2016.6

# The same message, repeated with noise.
# Part 1: the message made of each column's most common character.

example """
eedadn
drvtee
eandsr
raavrd
atevrs
tsrnev
sdttsa
rasrtv
nssdts
ntnada
svetve
tesnvt
vntsnd
vrdear
dvrsen
enarar
"""
  part1 = "easter"

answers
  part1 = "xhnqpqql"

columns = input.lines.transpose

part1 = columns.map(c => c.chars.counts.items.max_by(.1).0).join
