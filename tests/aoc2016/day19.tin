day 2016.19

# Elves in a circle, each in turn taking the presents of the elf to its
# left, who then leaves the circle.
# Part 1: the elf that ends up with every present.
# Part 2: the same, when each elf takes from the one across the circle
#         (the left one of two).

example "5"
  part1 = 3
  part2 = 2

answers
  part1 = 1841611
  part2 = 1423634

elves = int(input.trim)

# The Josephus problem with every second one out: with n = 2^k + m (m
# less than 2^k), elf 2m + 1 is left.
part1 = 2 * (elves - 2 ** (elves.bits - 1)) + 1

# Taking from across the circle has a closed form too, found by
# simulating small circles: with p the largest power of 3 not above n,
# elf n wins when n = p, elf n - p up to 2p, and elf 2n - 3p after that.
across(n) = if n == p then n else if n <= 2 * p then n - p else 2 * n - 3 * p
  where
    p = iterate(1, _ * 3).take_while(_ <= n).last

test "across small circles" = (1..10).map(across) == [1, 1, 3, 1, 2, 3, 5, 7, 9, 1]

part2 = across(elves)
