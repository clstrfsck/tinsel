day 2016.21

# A scrambler: swaps, rotations, reversals and moves applied in turn to a
# password's letters.
# Part 1: abcdefgh scrambled.
# Part 2: the password that scrambles to fbgdceah.

example """
swap position 4 with position 0
swap letter d with letter b
reverse positions 0 through 4
rotate left 1 step
move position 1 to position 4
move position 3 to position 0
rotate based on position of letter b
rotate based on position of letter d
"""
  with password = "abcde"
  part1 = "decab"

answers
  part1 = "dgfaehcb"
  part2 = "fdhgacbe"

password = "abcdefgh"

op(xs, "swap position {a:int} with position {b:int}") = xs.set(a, xs[b]).set(b, xs[a])
op(xs, "swap letter {a:char} with letter {b:char}") = xs.map(c => if c == a then b else if c == b then a else c)
op(xs, "rotate left {n:int} step{_}") = xs.rotate(n)
op(xs, "rotate right {n:int} step{_}") = xs.rotate(-n)
op(xs, "rotate based on position of letter {c:char}") = xs.rotate(-(1 + i + int(i >= 4)))
  where
    i = xs.index(c)
op(xs, "reverse positions {a:int} through {b:int}") = xs[..<a] ++ xs[a..b].reverse ++ xs[b + 1..]
op(xs, "move position {a:int} to position {b:int}") = rest[..<b] ++ [xs[a]] ++ rest[b..]
  where
    rest = xs[..<a] ++ xs[a + 1..]

scramble(s) = input.lines.fold(s.chars, op).join

part1 = scramble(password)

# Each operation undone. Swaps and reversals undo themselves. A rotation
# based on a letter is undone by finding the rotation it must have come
# from (for eight letters there is only one).
undo(xs, "rotate left {n:int} step{_}") = xs.rotate(-n)
undo(xs, "rotate right {n:int} step{_}") = xs.rotate(n)
undo(xs, "move position {a:int} to position {b:int}") = op(xs, "move position {b} to position {a}")
undo(xs, line) =
  if line.starts_with("rotate based") then xs.indices.map(xs.rotate(_)).first(ys => op(ys, line) == xs)
  else op(xs, line)

unscramble(s) = input.lines.reverse.fold(s.chars, undo).join

scrambled = "fbgdceah"

part2 = unscramble(scrambled)
