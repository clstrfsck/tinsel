day 2016.17

# A 4x4 grid of rooms from (0, 0) to the vault at (3, 3). Which doors are
# open depends on the MD5 hash of the passcode and the path so far: the
# first four hex digits are up, down, left and right, open if b to f.
# Part 1: the shortest path to the vault.
# Part 2: the length of the longest path to the vault (a path ends when
#         it reaches it).

example "ihgpwlah"
  part1 = "DDRRRD"
  part2 = 370

example "kglvqrro"
  part1 = "DDUDRLRRUDRD"
  part2 = 492

example "ulqzkmiv"
  part1 = "DRURDRUDDLLDLUURRDULRLDUUDDDRR"
  part2 = 830

answers
  part1 = "DUDRDLRRRD"
  part2 = 502

passcode = input.trim

doors = [('U', N), ('D', S), ('L', W), ('R', E)]

# A state: (room, path so far).
moves((room, path)) =
  if room == (3, 3) then []
  else [(next, path ++ str(name))
        for ((name, d), h) in zip(doors, md5(passcode ++ path).chars)
        if h in "bcdef"
        let next = room + d
        if next.0 in 0..3 and next.1 in 0..3]

part1 = bfs(((0, 0), ""), moves, goal: _.0 == (3, 3)).1.last.1

# Every path ends, as doors close, so the whole search is finite.
part2 = bfs(((0, 0), ""), moves).keys.filter(_.0 == (3, 3)).map(_.1.len).max
