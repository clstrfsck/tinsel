quest 2024.14

# Quest 14: a tree grows one segment a day in 3D, following a plan of steps
# such as `U5` (five segments up). Directions are absolute.
# Part 1: the height of the finished tree.
# Part 2: one plan per line, each a branch from the same ground segment;
#         the number of distinct segments.
# Part 3: each branch ends in a leaf. Tap the trunk (the segments straight
#         above the start) where the sum of the distances to every leaf,
#         through the tree's segments, is smallest; give that sum. Search
#         once from each leaf and add up their distances at each trunk
#         segment.

example "U5,R3,D2,L5,U4,R5,D2"
  part1 = 7

example """
U5,R3,D2,L5,U4,R5,D2
U6,L1,D2,R3,U2,L1
"""
  part2 = 32
  part3 = 5

example """
U20,L1,B1,L2,B1,R2,L1,F1,U1
U10,F1,B1,R1,L1,B1,L1,F1,R2,U1
U30,L2,F1,R1,B1,R1,F2,U1,F1
U25,R1,L2,B1,U1,R2,F1,L2
U16,L1,B1,L1,B3,L1,B1,F1
"""
  part3 = 46

answers
  part1 = 149
  part2 = 4823
  part3 = 1390

# The unit step for each direction, as (x, y, z) with y up.
dirs = { 'U': (0, 1, 0), 'D': (0, -1, 0), 'R': (1, 0, 0),
         'L': (-1, 0, 0), 'F': (0, 0, 1), 'B': (0, 0, -1) }

# Every segment of the tree grown from plan, in growing order.
grow(plan) = [dirs[s[0]] for s in plan.trim.split(",") for _ in 1..int(s[1..])]
               .scan((0, 0, 0), (p, d) => p + d).drop(1)

part1 = grow(input).map(.1).max

# Every segment of the tree, over all its branches.
tree(text) = set(p for plan in text.lines for p in grow(plan))

part2 = tree(input).len

# The smallest sum of the distances from a trunk segment to every leaf.
murkiness(text) = min(sum(d[p] for d in dists) for p in trunk)
  where
    t       = tree(text)
    trunk   = t.filter((x, y, z) => x == 0 and z == 0 and y > 0)
    near(p) = dirs.values.map(p + _).filter(_ in t)
    leaves  = text.lines.map(plan => grow(plan).last)
    dists   = [bfs(leaf, near) for leaf in leaves]

part3 = murkiness(input)
