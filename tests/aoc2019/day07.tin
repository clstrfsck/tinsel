day 2019.7
include "intcode.tin"

# Five amplifiers run copies of an Intcode program, each first given a
# phase setting and then a signal, passing its output to the next.
# Part 1: phases 0 to 4, once each, with the first signal 0. The highest
#         signal from the last amplifier.
# Part 2: phases 5 to 9, and the last amplifier feeds back into the first
#         until they halt. The highest final signal.

example """
3,15,3,16,1002,16,10,16,1,16,15,15,4,15,99,0,0
"""
  part1 = 43210

example """
3,23,3,24,1002,24,10,24,1002,23,-1,23,101,5,23,23,1,24,23,23,4,23,99,0,0
"""
  part1 = 54321

example """
3,31,3,32,1002,32,10,32,1001,31,-2,31,1007,31,0,33,1002,33,7,33,1,33,31,31,1,32,31,31,4,31,99,0,0,0
"""
  part1 = 65210

example """
3,26,1001,26,-4,26,3,27,1002,27,2,27,1,27,26,27,4,27,1001,28,-1,28,1005,28,6,99,0,0,5
"""
  part2 = 139629729

example """
3,52,1001,52,-5,52,3,53,1,52,56,54,1007,54,5,55,1005,55,26,1001,54,-5,54,1105,1,12,1,53,54,53,1008,54,0,55,1001,55,1,55,2,53,55,53,4,53,1001,56,-1,56,1005,56,6,99,0,0,0,0,10
"""
  part2 = 18216

answers
  part1 = 273814
  part2 = 34579864

chain(phases) = phases.fold(0, (signal, p) => outputs(input, [p, signal])[0])

# Each amplifier is a machine waiting for its next signal. Pass the signal
# once round the loop, giving (machines, signal, whether the last halted).
round(machines, signal) = machines.fold(([], signal, false), amplify)
amplify((done, signal, _), m) = after(done, run(m, [signal]))
after(done, (status, m, outs)) = (done ++ [m], outs.last, status == "halt")

loop(machines, signal) = if halted then out else loop(next, out)
  where
    (next, out, halted) = round(machines, signal)

feedback(phases) = loop(phases.map(p => run(intcode(input), [p]).1), 0)

part1 = (0..4).perms.map(chain).max
part2 = (5..9).perms.map(feedback).max
