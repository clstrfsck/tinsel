day 2019.19
include "intcode.tin"

# An Intcode program reports whether a drone sent to (x, y) is pulled by a
# tractor beam. The beam spreads out from (0, 0) in a narrow cone.
# Part 1: how many points with 0 <= x, y < 50 are in the beam.
# Part 2: the 100x100 square in the beam closest to the emitter. Give
#         x * 10000 + y for its top left corner.

answers
  part1 = 131
  part2 = 15231022

drone = intcode(input)

pulled(x, y) = run(drone, [x, y]).2[0] == 1

# In each row the beam is one run of points, and both its ends move right
# (or stay put) from one row to the next. So each row's search starts where
# the last row's beam began. Near the emitter, some rows miss the beam.
scan(50, _, total) = total
scan(y, lo, total) = match (lo..<50).first(pulled(_, y))
  none => scan(y + 1, lo, total)
  x => scan(y + 1, x, total + (x..<50).take_while(pulled(_, y)).len)

part1 = scan(0, 0, 0)

# Try each row as the square's bottom: its left end is the beam's left end
# in that row, and the square fits if its top right corner is in the beam.
square(y, lo) = if pulled(x + 99, y - 99) then x * 10000 + (y - 99) else square(y + 1, x)
  where
    x = (lo..).first(pulled(_, y))

part2 = square(100, 0)
