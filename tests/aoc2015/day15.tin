day 2015.15

# Cookie ingredients, each with capacity, durability, flavor, texture and
# calories per teaspoon. A cookie takes 100 teaspoons in all.
# Part 1: the best score: the product of the first four properties'
#         totals (each at least 0).
# Part 2: the best score of a cookie with exactly 500 calories.

example """
Butterscotch: capacity -1, durability -2, flavor 6, texture 3, calories 8
Cinnamon: capacity 2, durability 3, flavor -2, texture -1, calories 3"""
  part1 = 62_842_880
  part2 = 57_600_000

answers
  part1 = 13_882_464
  part2 = 11_171_160

ingredients = input.lines.map(.ints)

# Every way to split `total` teaspoons between n ingredients.
splits(1, total) = [[total]]
splits(n, total) = [[a] ++ rest for a in 0..total for rest in splits(n - 1, total - a)]

# Each property's total for some amounts, one per property.
totals(amounts) = ingredients.transpose.map(prop => zip(amounts, prop).map(((a, x)) => a * x).sum)

score(amounts) = totals(amounts).take(4).map(max(_, 0)).product

cookies = splits(ingredients.len, 100)

part1 = cookies.map(score).max
part2 = cookies.filter(a => totals(a)[4] == 500).map(score).max
