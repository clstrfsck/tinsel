day 2015.16

# 500 Aunts Sue, each with a few remembered things (children, cats, ...),
# and the readings from the gift.
# Part 1: the number of the Sue whose remembered things all match.
# Part 2: the same, when the cats and trees readings are less than the
#         true counts, and the pomeranians and goldfish readings more.

answers
  part1 = 103
  part2 = 405

reading = {
  "children": 3, "cats": 7, "samoyeds": 2, "pomeranians": 3, "akitas": 0,
  "vizslas": 0, "goldfish": 5, "trees": 3, "cars": 2, "perfumes": 1,
}

# Each Sue: (number, what is remembered about her).
sues = [(n, {k: v for "{k}: {v:int}" in things.split(", ")}) for "Sue {n:int}: {things}" in input.lines]

sue(fits) = sues.first(((_, known)) => known.items.all(((k, v)) => fits(k, v))).0

part1 = sue((k, v) => reading[k] == v)

ranged("cats", v) = v > reading["cats"]
ranged("trees", v) = v > reading["trees"]
ranged("pomeranians", v) = v < reading["pomeranians"]
ranged("goldfish", v) = v < reading["goldfish"]
ranged(k, v) = v == reading[k]

part2 = sue(ranged)
