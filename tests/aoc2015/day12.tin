day 2015.12

# A JSON document; no string in it holds a number.
# Part 1: the sum of all its numbers.
# Part 2: the same, leaving out every object (and everything in it) with
#         a value of "red".

example "[1,2,3]"
  part1 = 6

example """{"a":{"b":4},"c":-1}"""
  part1 = 3

example """{"a":[-1,1]}"""
  part1 = 0

example "[]"
  part1 = 0

example """[1,{"c":"red","b":2},3]"""
  part2 = 4

example """{"d":"red","e":[1,2,3,4],"f":5}"""
  part2 = 0

example """[1,"red",5]"""
  part2 = 6

answers
  part1 = 119_433
  part2 = 68466

part1 = input.ints.sum

# A JSON value read from position i of s: (the value, the position after
# it). Arrays become lists, objects maps, strings strs and numbers ints;
# there is no whitespace. Only the structure is needed, so this is just
# enough JSON for the puzzle.
parse(s, i) = match s[i]
  '[' => elements(s, i + 1, [])
  '{' => members(s, i + 1, {})
  '"' => string_at(s, i)
  _ => number_at(s, i)

string_at(s, i) = (s[i + 1..<end], end + 1)
  where
    end = i + 1 + s[i + 1..].index('"')

number_at(s, i) = (int(s[i..<end]), end)
  where
    end = (i..s.len).first(j => j == s.len or s[j] not in "-0123456789")

# The rest of an array or object, from just after its `[` or `{`, or a
# comma.
elements(s, i, items) =
  if s[i] == ']' then (items, i + 1)
  else elements(s, after, items ++ [v])
  where
    (v, j) = parse(s, if s[i] == ',' then i + 1 else i)
    after = j

members(s, i, fields) =
  if s[i] == '}' then (fields, i + 1)
  else members(s, j, fields.set(k, v))
  where
    (k, colon) = parse(s, if s[i] == ',' then i + 1 else i)
    (v, j) = parse(s, colon + 1)

# The sum of the numbers in a value, leaving out red objects.
unred(n: int) = n
unred(xs: list) = xs.map(unred).sum
unred(m: map) = if "red" in m.values then 0 else m.values.map(unred).sum
unred(_) = 0

part2 = unred(parse(input.trim, 0).0)
