day 2015.8

# String literals, one per line, with the escapes \\, \" and \x plus two
# hex digits.
# Part 1: the characters of code minus the characters in memory, over
#         all the literals.
# Part 2: the characters of each literal encoded again as a literal
#         (quoted, with " and \ escaped), minus the characters of code.

example """
""
"abc"
"aaa\"aaa"
"\x27"
"""
  part1 = 12
  part2 = 19

answers
  part1 = 1371
  part2 = 2117

# The characters a literal's text (between its quotes) stands for,
# counting from position i.
in_memory(s, i, n) =
  if i >= s.len then n
  else if s[i] != '\\' then in_memory(s, i + 1, n + 1)
  else if s[i + 1] == 'x' then in_memory(s, i + 4, n + 1)
  else in_memory(s, i + 2, n + 1)

part1 = input.lines.map(l => l.len - in_memory(l[1..<l.len - 1], 0, 0)).sum

# Two quotes, and a backslash before each " and \.
part2 = input.lines.map(l => 2 + l.chars.count(c => c in "\"\\")).sum
