day 2023.22

# Bricks of sand in 3D, given by opposite corners, fall until they land on
# the ground (z = 0) or on another brick.
# Part 1: how many bricks could be removed without any other brick falling.
# Part 2: for each brick, how many other bricks would fall if it were
#         removed. Add these up.

example """
1,0,1~1,2,1
0,0,2~2,0,2
0,2,3~2,2,3
0,0,4~0,2,4
2,0,5~2,2,5
0,1,6~2,1,6
1,1,8~1,1,9
"""
  part1 = 5
  part2 = 7

answers
  part1 = 463
  part2 = 89727

bricks = input.lines.map(.ints).sort_by(b => b[2])

# Drop the bricks lowest first, tracking the top of the pile as a map from
# (x, y) to (height, brick). Each brick records the bricks it rests on.
supports = bricks.enumerate.fold(({}, []), drop).1
  where
    drop((tops, below), (i, [x1, y1, z1, x2, y2, z2])) =
      (tops | {c: (top + z2 - z1 + 1, i) for c in cells},
       below ++ [{j for c in cells let (z, j) = tops.get(c, (0, -1)) if z == top and j >= 0}])
      where
        cells = [(x, y) for x in x1..x2 for y in y1..y2]
        top = cells.map(c => tops.get(c, (0, -1)).0).max

# Bricks held up by brick i alone.
sole = {s for s in supports if s.len == 1}.map(s => s.first)

part1 = bricks.len - set(sole).len

# The bricks resting on each brick.
above = [(j, i) for (j, s) in supports.enumerate for i in s].group_by(.1, .0)

# Remove brick i, then go up the pile in order (a sorted set of candidates
# serves as the queue): a brick falls when everything it rests on has fallen.
falls(i) = go(set(rests_on(i)), {i})
  where
    rests_on(k) = above.get(k, [])
    go(todo, gone) =
      if todo.len == 0 then gone.len - 1
      else if (supports[j] - gone).len == 0 then go(todo.remove(j) | set(rests_on(j)), gone.add(j))
      else go(todo.remove(j), gone)
      where
        j = todo.min

part2 = bricks.indices.map(falls).sum
