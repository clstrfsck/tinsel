day 2023.19

# Workflows send parts (rated x, m, a, s) through rules to other workflows,
# until they are accepted (A) or rejected (R). Every part starts at "in".
# Part 1: add up all the ratings of the accepted parts.
# Part 2: how many combinations of ratings from 1 to 4000 are accepted.

example """
px{a<2006:qkq,m>2090:A,rfg}
pv{a>1716:R,A}
lnx{m>1548:A,A}
rfg{s<537:gd,x>2440:R,A}
qs{s>3448:A,lnx}
qkq{x<1416:A,crn}
crn{x>2662:A,R}
in{s<1351:px,qqz}
qqz{s>2770:qs,m<1801:hdj,R}
gd{a>3333:R,R}
hdj{m>838:A,pv}

{x=787,m=2655,a=1222,s=2876}
{x=1679,m=44,a=2067,s=496}
{x=2036,m=264,a=79,s=2244}
{x=2461,m=1339,a=466,s=291}
{x=2127,m=1623,a=2188,s=1013}
"""
  part1 = 19114
  part2 = 167409079868000

answers
  part1 = 456651
  part2 = 131899818301477

[workflow_text, part_text] = input.blocks

# A rule is (category, op, n, destination); the last rule is just a name.
rule("{c:char}{op:char}{n:int}:{dest}") = (c, op, n, dest)
rule(dest) = dest

workflows = {name: rules.split(",").map(rule) for "{name}{{{rules}}}" in workflow_text.lines}
parts = [{c: n for "{c:char}={n:int}" in p[1..<-1].split(",")} for p in part_text.lines]

# Part 2 works on boxes: a map from category to an inclusive (lo, hi). Part
# 1 is the same, with each box holding a single part.
accepted("A", box) = box.values.map((lo, hi) => hi - lo + 1).product
accepted("R", _) = 0
accepted(name, box) = through(workflows[name], box)

through([dest], box) = accepted(dest, box)
through([(c, op, n, dest), ..rest], box) = taken + left
  where
    (lo, hi) = box[c]
    (yes, no) = if op == '<' then ((lo, min(hi, n - 1)), (max(lo, n), hi))
                else ((max(lo, n + 1), hi), (lo, min(hi, n)))
    taken = if yes.0 <= yes.1 then accepted(dest, box.set(c, yes)) else 0
    left = if no.0 <= no.1 then through(rest, box.set(c, no)) else 0

part1 = sum(p.values.sum for p in parts if accepted("in", {c: (n, n) for (c, n) in p.items}) > 0)
part2 = accepted("in", {c: (1, 4000) for c in "xmas"})
