day 2023.4

# Scratchcards: winning numbers | numbers you have.
# Part 1: a card with n matches is worth 2 ** (n - 1) points. Add them up.
# Part 2: a card with n matches wins a copy of each of the next n cards.
#         How many cards do you end up with?

example """
Card 1: 41 48 83 86 17 | 83 86  6 31 17  9 48 53
Card 2: 13 32 20 16 61 | 61 30 68 82 17 32 24 19
Card 3:  1 21 53 59 44 | 69 82 63 72 16 21 14  1
Card 4: 41 92 73 84 69 | 59 84 76 51 58  5 54 83
Card 5: 87 83 26 28 32 | 88 30 70 12 93 22 82 36
Card 6: 31 18 13 56 72 | 74 77 10 23 35 67 36 11
"""
  part1 = 13
  part2 = 30

answers
  part1 = 15205
  part2 = 6189740

matches = [(set(win.ints) & set(have.ints)).len for "Card {_}: {win} | {have}" in input.lines]

part1 = sum(2 ** (n - 1) for n in matches if n > 0)

# How many cards card i ends up as, counting itself and everything it wins.
# Memoized automatically.
cards(i) = 1 + sum(cards(j) for j in i + 1..i + matches[i])

part2 = matches.indices.map(cards).sum
