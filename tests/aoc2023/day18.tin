day 2023.18

# A dig plan: each line digs a trench some distance in a direction.
# Part 1: how many cubic metres the trench and its interior hold.
# Part 2: the real instructions are in the hex codes: five hex digits of
#         distance, then a direction digit (0 R, 1 D, 2 L, 3 U).

example """
R 6 (#70c710)
D 5 (#0dc571)
L 2 (#5713f0)
D 2 (#d2c081)
R 2 (#59c680)
D 2 (#411b91)
L 5 (#8ceee2)
U 2 (#caa173)
L 1 (#1b58a2)
U 2 (#caa171)
R 2 (#7807d2)
U 3 (#a77fa3)
L 2 (#015232)
U 2 (#7a21e3)
"""
  part1 = 62
  part2 = 952408144115

answers
  part1 = 31171
  part2 = 131431655002266

plan = [(d, n, hex) for "{d:char} {n:int} (#{hex})" in input.lines]

DIRS = {'R': E, 'D': S, 'L': W, 'U': N}

# The trench's corners, then Pick's theorem: interior points plus the
# boundary points.
lagoon(steps) = shoelace(corners) + edge / 2 + 1
  where
    corners = steps.scan((0, 0), (p, (d, n)) => p + d * n)
    edge = steps.map(.1).sum

part1 = lagoon([(DIRS[d], n) for (d, n, _) in plan])
part2 = lagoon([(DIRS["RDLU"[int(hex[5..])]], int(hex[..<5], 16)) for (_, _, hex) in plan])
