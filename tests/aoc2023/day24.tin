day 2023.24

# Hailstones, each with a position and a velocity "px, py, pz @ vx, vy, vz".
# Part 1: how many pairs of hailstone paths (ignoring z) cross in the
#         future, inside the square lo..hi on both axes.
# Part 2: throw a rock from some position with some velocity so that it
#         hits every hailstone. Add up the coordinates of its start.

example """
19, 13, 30 @ -2,  1, -2
18, 19, 22 @ -1, -1, -2
20, 25, 34 @ -2, -2, -4
12, 31, 28 @ -1, -2, -1
20, 19, 15 @  1, -5, -3
"""
  with lo = 7
  with hi = 27
  part1 = 2
  part2 = 47

answers
  part1 = 12343
  part2 = 769281292688187

lo = 200000000000000
hi = 400000000000000

stones = input.lines.map(l => (tuple(l.ints[..<3]), tuple(l.ints[3..])))

# Solve p1 + t * v1 == p2 + s * v2 in x and y with Cramer's rule, keeping
# everything in whole numbers: t = tn / det and s = sn / det.
crosses(((x1, y1, _), (vx1, vy1, _)), ((x2, y2, _), (vx2, vy2, _))) =
  det != 0 and tn * sign(det) > 0 and sn * sign(det) > 0
    and inside(x1 * det + tn * vx1) and inside(y1 * det + tn * vy1)
  where
    det = vx2 * vy1 - vx1 * vy2
    (dx, dy) = (x2 - x1, y2 - y1)
    tn = vx2 * dy - vy2 * dx
    sn = vx1 * dy - vy1 * dx
    # lo <= value / det <= hi, without dividing.
    inside(n) = if det > 0 then lo * det <= n <= hi * det else hi * det <= n <= lo * det

part1 = stones.combos(2).count(crosses)

# A rock at P with velocity V hits stone i when (P - p_i) x (V - v_i) == 0.
# Subtracting that equation for two stones cancels the P x V term and
# leaves three linear equations in P and V. Two pairs give six.
cross_rows((pi, vi), (pj, vj)) = zip(rows, rhs)
  where
    (wx, wy, wz) = vj - vi
    (ux, uy, uz) = pj - pi
    rows = [[0, wz, -wy, 0, -uz, uy],
            [-wz, 0, wx, uz, 0, -ux],
            [wy, -wx, 0, -uy, ux, 0]]
    rhs = cross(pj, vj) - cross(pi, vi)
    cross((a, b, c), (d, e, f)) = (b * f - c * e, c * d - a * f, a * e - b * d)

part2 = solution[..<3].sum
  where
    equations = cross_rows(stones[0], stones[1]) ++ cross_rows(stones[0], stones[2])
    solution = solve(equations.map(.0), equations.map(.1))
