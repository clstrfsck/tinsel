day 2023.17

# A grid of heat-loss digits. Move a crucible from the top left to the
# bottom right, turning left or right (never reversing), adding up the heat
# loss of each block entered.
# Part 1: the least heat loss, moving at most 3 blocks before turning.
# Part 2: an ultra crucible moves at least 4 and at most 10 blocks before
#         turning (or stopping at the end).

example """
2413432311323
3215453535623
3255245654254
3446585845452
4546657867536
1438598798454
4457876987766
3637877979653
4654967986887
4564679986453
1224686865563
2546548887735
4322674655533
"""
  part1 = 102
  part2 = 94

example """
111111111111
999999999991
999999999991
999999999991
999999999991
"""
  part2 = 71

answers
  part1 = 742
  part2 = 918

city = input.grid(int)
goal = (city.width - 1, city.height - 1)

# A state is (position, whether the last move was horizontal). Each step is
# a whole straight run of lo to hi blocks, followed by a turn.
least_loss(lo, hi) = dijkstra_from([((0, 0), true), ((0, 0), false)], next, goal: ((p, _)) => p == goal).0
  where
    next((p, horizontal)) =
      [((p + d * k, not horizontal), sum(city[p + d * i] for i in 1..k))
         for d in (if horizontal then [N, S] else [E, W])
         for k in lo..hi
         if p + d * k in city]

part1 = least_loss(1, 3)
part2 = least_loss(4, 10)
