answers
  part1 = 7173
  part2 = 291

maze = input.grid
start = maze.find('S')

# The directions each pipe connects.
pipes = {'|': [N, S], '-': [E, W], 'L': [N, E], 'J': [N, W], '7': [S, W], 'F': [S, E]}
exits(p) = pipes.get(maze.get(p), [])

# Leave S along any pipe that connects back to it, and follow the loop.
loop = walk(start + d0, d0, [start])
  where
    d0 = DIRS4.first(d => -d in exits(start + d))
    walk(p, _, path) when p == start = path
    walk(p, d, path) = walk(p + e, e, path ++ [p])
      where
        e = exits(p).first(_ != -d)

part1 = loop.len / 2

# Pick's theorem: the interior points of a lattice polygon.
part2 = shoelace(loop) - loop.len / 2 + 1
