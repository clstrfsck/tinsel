day 2018.23

# Nanobots, each with a position in 3D and a signal radius (by Manhattan
# distance).
# Part 1: how many nanobots are in range of the one with the largest
#         radius, including itself.
# Part 2: the distance from 0,0,0 to the nearest point in range of the
#         most nanobots.

example """
pos=<0,0,0>, r=4
pos=<1,0,0>, r=1
pos=<4,0,0>, r=3
pos=<0,2,0>, r=1
pos=<0,5,0>, r=3
pos=<0,0,3>, r=1
pos=<1,1,1>, r=1
pos=<1,1,2>, r=1
pos=<1,3,1>, r=1
"""
  part1 = 7

example """
pos=<10,12,12>, r=2
pos=<12,14,12>, r=2
pos=<16,12,12>, r=4
pos=<14,14,14>, r=6
pos=<50,50,50>, r=200
pos=<10,10,10>, r=5
"""
  part2 = 36

answers
  part1 = 704
  part2 = 111960222

bots = [((x, y, z), r) for [x, y, z, r] in input.lines.map(.ints)]

part1 = bots.count((p, _) => manhattan(p, centre) <= radius)
  where
    (centre, radius) = bots.max_by(.1)

# Searches boxes, best first, splitting each into eight. The number of
# bots in range of some point of a box only falls when it is split, and
# its distance from the origin only grows, so a box's priority
#   (bots out of range) * spread + (distance from the origin)
# never falls either. That makes the search a Dijkstra search with the
# rises in priority as costs, and the first single point it reaches is
# the answer.
spread = 2 ** 40

# A box is (lowest corner, side), with a side that is a power of two.
gap(p, (lo, side)) = [max(0, l - c, c - (l + side - 1)) for (c, l) in zip(p, lo)].sum

priority(box) = bots.count((p, r) => gap(p, box) > r) * spread + gap((0, 0, 0), box)

halves((lo, side)) = [(lo + (dx, dy, dz) * half, half) for dx in 0..1 for dy in 0..1 for dz in 0..1]
  where
    half = side / 2

whole = (lows, 2 ** (highs - lows).max.bits)
  where
    lows = bots.map(.0).bounds.map(.0).tuple
    highs = bots.map(.0).bounds.map(.1).tuple

part2 = (cost + priority(whole)) % spread
  where
    next(box) = halves(box).map(b => (b, priority(b) - priority(box)))
    (cost, _) = dijkstra(whole, next, goal: b => b.1 == 1)
