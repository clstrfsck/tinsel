day 2018.3

# Claims on a sheet of fabric: #id @ left,top: widthxheight.
# Part 1: how many square inches are inside two or more claims.
# Part 2: the ID of the one claim that overlaps no other.

example """
#1 @ 1,3: 4x4
#2 @ 3,1: 4x4
#3 @ 5,5: 2x2
"""
  part1 = 4
  part2 = 3

answers
  part1 = 107663
  part2 = 1166

claims = [(id, (x, y), (w, h)) for "#{id:int} @ {x:int},{y:int}: {w:int}x{h:int}" in input.lines]

squares((_, (x, y), (w, h))) = [(i, j) for i in x..<x + w for j in y..<y + h]

coverage = [p for c in claims for p in squares(c)].counts

part1 = coverage.values.count(_ >= 2)

part2 = claims.first(c => squares(c).all(coverage[_] == 1)).0
