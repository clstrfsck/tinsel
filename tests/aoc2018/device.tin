# The wrist device's instruction set (2018 days 16, 19 and 21).
#
#   ops         map from each opcode name to its function (a, b, regs),
#               which gives the value the instruction stores
#   exec(f, a, b, c, regs)
#               regs (a tuple) after running instruction f with a, b, c
#   program(text)
#               a program with an instruction pointer register (day 19):
#               (ip register, instructions), each instruction a tuple
#               (name, a, b, c)
#   run(prog, regs, stop)
#               runs prog from instruction 0 until the instruction pointer
#               leaves the program or stop(ip) is true before an
#               instruction; gives (ip, regs)
#
# Names ending in r read register B (or A, for setr); ending in i use B
# (or A) as a value. gtir and eqir use value A and register B.

ops = {
  "addr": (a, b, r) => r[a] + r[b],
  "addi": (a, b, r) => r[a] + b,
  "mulr": (a, b, r) => r[a] * r[b],
  "muli": (a, b, r) => r[a] * b,
  "banr": (a, b, r) => r[a] & r[b],
  "bani": (a, b, r) => r[a] & b,
  "borr": (a, b, r) => r[a] | r[b],
  "bori": (a, b, r) => r[a] | b,
  "setr": (a, _, r) => r[a],
  "seti": (a, _, _) => a,
  "gtir": (a, b, r) => int(a > r[b]),
  "gtri": (a, b, r) => int(r[a] > b),
  "gtrr": (a, b, r) => int(r[a] > r[b]),
  "eqir": (a, b, r) => int(a == r[b]),
  "eqri": (a, b, r) => int(r[a] == b),
  "eqrr": (a, b, r) => int(r[a] == r[b]),
}

exec(f, a, b, c, regs) = regs.set(c, f(a, b, regs))

program(text) = (first.ints[0], [(name, a, b, c) for "{name} {a:int} {b:int} {c:int}" in rest])
  where
    [first, ..rest] = text.lines

run((ipr, instructions), regs, stop) = go(code, ipr, 0, regs, stop)
  where
    code = instructions.map((name, a, b, c) => (ops[name], a, b, c))

# The instruction pointer is written to its register before each
# instruction, and read back (plus one) after it.
go(code, ipr, ip, regs, stop) =
  if ip < 0 or ip >= code.len or stop(ip) then (ip, regs)
  else after(code, ipr, stop, step(code[ip], regs.set(ipr, ip)))

step((f, a, b, c), regs) = exec(f, a, b, c, regs)

after(code, ipr, stop, regs) = go(code, ipr, regs[ipr] + 1, regs, stop)

test "sixteen opcodes" = ops.len == 16
test "addi" = exec(ops["addi"], 2, 7, 3, (5, 0, 4, 0)) == (5, 0, 4, 11)
test "gtir" = exec(ops["gtir"], 9, 0, 1, (3, 0, 0, 0)) == (3, 1, 0, 0)
test "setr ignores b" = exec(ops["setr"], 2, 99, 0, (0, 0, 8, 0)) == (8, 0, 8, 0)

sample = program("""
#ip 0
seti 5 0 1
seti 6 0 2
addi 0 1 0
addr 1 2 3
setr 1 0 0
seti 8 0 4
seti 9 0 5
""")

test "program with a jump" = run(sample, (0, 0, 0, 0, 0, 0), _ => false) == (7, (6, 5, 6, 0, 0, 9))
test "stop before an instruction" = run(sample, (0, 0, 0, 0, 0, 0), _ == 4).0 == 4
