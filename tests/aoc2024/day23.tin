day 2024.23

# A network map: each line connects two computers.
# Part 1: how many sets of three connected computers include a computer
#         whose name starts with t.
# Part 2: the largest set of computers all connected to each other, as a
#         sorted, comma-separated password.

example """
kh-tc
qp-kh
de-cg
ka-co
yn-aq
qp-ub
cg-tb
vc-aq
tb-ka
wh-tc
yn-cg
kh-ub
ta-co
de-co
tc-td
tb-wq
wh-td
ta-ka
td-qp
aq-cg
wq-ub
ub-vc
de-ta
wq-aq
wq-vc
wh-yn
ka-de
kh-ta
co-tc
wh-qp
tb-vc
td-yn
"""
  part1 = 7
  part2 = "co,de,ka,ta"

answers
  part1 = 1230
  part2 = "az,cj,kp,lm,lt,nj,rf,rx,sn,ty,ui,wp,zo"

links = input.lines.map(.split("-"))
edges = links.map(.tuple) ++ links.map(.reverse.tuple)
adj = {a: set(bs) for (a, bs) in edges.group_by(.0, .1).items}

part1 = {set([a, b, c]) for a in adj.keys for b in adj[a] for c in adj[a] & adj[b]
           if [a, b, c].any(.starts_with("t"))}.len

# Bron-Kerbosch with a pivot: the largest clique containing all of r, some
# of p and none of x.
@nomemo
clique(r, p, x) =
  if p.len == 0 then (if x.len == 0 then r else set())
  else (p - adj[pivot]).fold((set(), p, x), ((best, p, x), v) =>
         (larger(best, clique(r.add(v), p & adj[v], x & adj[v])), p.remove(v), x.add(v))).0
  where
    pivot = (p | x).max_by(u => (p & adj[u]).len)

larger(a, b) = if b.len > a.len then b else a

part2 = clique(set(), set(adj.keys), set()).join(",")
