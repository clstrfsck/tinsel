day 2024.2

# Each line is a report of levels.
# Part 1: count reports that are safe: strictly increasing or decreasing,
#         by steps of 1 to 3.
# Part 2: count reports that are safe, or would be with one level removed.

example """
7 6 4 2 1
1 2 7 8 9
9 7 6 2 1
1 3 2 4 5
8 6 4 4 1
1 3 6 7 9
"""
  part1 = 2
  part2 = 4

answers
  part1 = 379
  part2 = 430

reports = input.lines.map(.ints)

safe(r) = diffs.all(1 <= _ <= 3) or diffs.all(-3 <= _ <= -1)
  where
    diffs = r.pairs.map((a, b) => b - a)

dampened(r) = r.indices.any(i => safe(r[..<i] ++ r[i + 1..]))

part1 = reports.count(safe)
part2 = reports.count(dampened)
