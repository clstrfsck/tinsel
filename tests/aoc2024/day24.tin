day 2024.24

# A circuit of AND, OR and XOR gates. Wires x.. and y.. start with values.
# Part 1: the number formed by the z.. wires (z00 is the lowest bit).
# Part 2: the circuit is meant to add x and y, but four pairs of gate
#         outputs have been swapped. List the eight wires, sorted and
#         joined with commas.

example """
x00: 1
x01: 1
x02: 1
y00: 0
y01: 1
y02: 0

x00 AND y00 -> z00
x01 XOR y01 -> z01
x02 OR y02 -> z02
"""
  part1 = 4

example """
x00: 1
x01: 0
x02: 1
x03: 1
x04: 0
y00: 1
y01: 1
y02: 1
y03: 1
y04: 1

ntg XOR fgs -> mjb
y02 OR x01 -> tnw
kwq OR kpj -> z05
x00 OR x03 -> fst
tgd XOR rvg -> z01
vdt OR tnw -> bfw
bfw AND frj -> z10
ffh OR nrd -> bqk
y00 AND y03 -> djm
y03 OR y00 -> psh
bqk OR frj -> z08
tnw OR fst -> frj
gnj AND tgd -> z11
bfw XOR mjb -> z00
x03 OR x00 -> vdt
gnj AND wpb -> z02
x04 AND y00 -> kjc
djm OR pbm -> qhw
nrd AND vdt -> hwm
kjc AND fst -> rvg
y04 OR y02 -> fgs
y01 AND x02 -> pbm
ntg OR kjc -> kwq
psh XOR fgs -> tgd
qhw XOR tgd -> z09
pbm OR djm -> kpj
x03 XOR y03 -> ffh
x00 XOR y04 -> ntg
bfw OR bqk -> z06
nrd XOR fgs -> wpb
frj XOR qhw -> z04
bqk OR frj -> z07
y03 OR x01 -> nrd
hwm AND bqk -> z03
tgd XOR rvg -> z12
tnw OR pbm -> gnj
"""
  part1 = 2024

answers
  part1 = 69201640933606
  part2 = "dhq,hbs,jcp,kfp,pdg,z18,z22,z27"

[wire_text, gate_text] = input.blocks
initial = {w: v for "{w}: {v:int}" in wire_text.lines}
gates = {out: (a, op, b) for "{a} {op} {b} -> {out}" in gate_text.lines}

# Memoized automatically: each wire is computed once.
value(w) = match gates.get(w)
  none => initial[w]
  (a, "AND", b) => value(a) & value(b)
  (a, "OR", b) => value(a) | value(b)
  (a, "XOR", b) => value(a) xor value(b)

zs = gates.keys.filter(.starts_with("z")).sort
part1 = zs.reverse.fold(0, (n, z) => n * 2 + value(z))

# A ripple-carry adder has a fixed shape. For each bit i > 0:
#   x_i XOR y_i -> s_i      s_i XOR carry -> z_i
#   x_i AND y_i -> c_i      s_i AND carry -> d_i      c_i OR d_i -> carry
# A gate whose output breaks that shape has been swapped:
#  - every z wire except the last comes from an XOR;
#  - an XOR that doesn't read x and y must write a z wire;
#  - an XOR of x_i and y_i (i > 0) must feed another XOR;
#  - an AND (other than x00 AND y00) must feed an OR.
input_wire(w) = w.starts_with("x") or w.starts_with("y")
feeds(w, op) = gates.values.any((a, o, b) => o == op and w in [a, b])

wrong(out, (a, op, b)) =
  (out.starts_with("z") and op != "XOR" and out != zs.last) or
  (op == "XOR" and not input_wire(a) and not out.starts_with("z")) or
  (op == "XOR" and input_wire(a) and a[1..] != "00" and not feeds(out, "XOR")) or
  (op == "AND" and a[1..] != "00" and not feeds(out, "OR"))

part2 = gates.items.filter((out, g) => wrong(out, g)).map(.0).sort.join(",")
