day 2024.13

# Claw machines: button A costs 3 tokens and button B costs 1. Each press
# moves the claw by the button's (X, Y).
# Part 1: the fewest tokens needed to win every prize that can be won.
# Part 2: the same, with every prize 10000000000000 further along both axes.

example """
Button A: X+94, Y+34
Button B: X+22, Y+67
Prize: X=8400, Y=5400

Button A: X+26, Y+66
Button B: X+67, Y+21
Prize: X=12748, Y=12176

Button A: X+17, Y+86
Button B: X+84, Y+37
Prize: X=7870, Y=6450

Button A: X+69, Y+23
Button B: X+27, Y+71
Prize: X=18641, Y=10279
"""
  part1 = 280 + 200

answers
  part1 = 28059
  part2 = 102255878088512

machines = input.blocks.map(.ints)

# Two equations in two unknowns: solve gives the whole-number solution, or
# none.
tokens(shift, [ax, ay, bx, by, px, py]) = match solve([[ax, bx], [ay, by]], [px + shift, py + shift])
  [a, b] when a >= 0 and b >= 0 => 3 * a + b
  _ => 0

part1 = machines.map(m => tokens(0, m)).sum
part2 = machines.map(m => tokens(10000000000000, m)).sum
