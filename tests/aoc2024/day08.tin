day 2024.8

# Antennas on a map; each letter or digit is a frequency.
# Part 1: count positions on the map where, for two antennas of the same
#         frequency, one is twice as far away as the other, in line.
# Part 2: count positions in line with at least two antennas of the same
#         frequency.

example """
............
........0...
.....0......
.......0....
....0.......
......A.....
............
............
........A...
.........A..
............
............
"""
  part1 = 14
  part2 = 34

answers
  part1 = 413
  part2 = 1417

city = input.grid

antennas = city.positions.filter(city[_] != '.').group_by(city[_]).values

# Ordered pairs of antennas with the same frequency.
pairs = [(a, b) for group in antennas for a in group for b in group if a != b]

part1 = {2 * b - a for (a, b) in pairs if 2 * b - a in city}.len

part2 = {p for (a, b) in pairs
           for k in 0..max(city.width, city.height)
           let p = b + (b - a) * k
           if p in city}.len
