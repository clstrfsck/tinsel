  part1 = 13140

answers
  part1 = 12560
  part2 = "PLPAFBCL"

# Each instruction becomes one change to X per cycle it takes.
deltas_of("noop") = [0]
deltas_of("addx {v:int}") = [0, v]

# x[i] is the value of X during cycle i + 1.
x = input.lines.map(deltas_of).flatten.scan(1, (a, b) => a + b)

part1 = [c * x[c - 1] for c in 20..220 if c % 40 == 20].sum

screen = [[if abs(x[40 * r + c] - c) <= 1 then '#' else '.' for c in 0..<40].join for r in 0..<6]

part2 = ocr(screen)
