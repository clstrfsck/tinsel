day 2022.10
include "../lib/ocr.tin"

# A CPU with one register X (starting at 1). noop takes one cycle; addx v
# takes two, and adds v to X after them.
# Part 1: the sum of cycle * X during cycles 20, 60, ..., 220.
# Part 2: X is a sprite 3 pixels wide; a CRT draws pixel (cycle - 1) % 40 of
#         a 40x6 screen each cycle, lit if the sprite covers it. Read the
#         eight capital letters on the screen.

